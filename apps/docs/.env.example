# Copy to .env.local. Every setting is optional locally: without any of them you get the docs with
# search and no analytics. The table in README.md, "Settings", says what each one does and which a
# production build requires.

# Analytics. Unset: no events.
# NEXT_PUBLIC_POSTHOG_KEY=
# Default: https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_HOST=

# The dashboard the Dashboard link opens. Default: https://cloud.trigger.dev
# NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3030

# Another server for the API playground (a local or staging API).
# DOCS_API_SERVER_URL=http://localhost:3030
# Hosts other than localhost that may load `next dev` (comma-separated).
# DOCS_DEV_ORIGINS=
# Build tuning: see README.md, "Dev server" and "SDK types in the docs".
# DOCS_TWOSLASH=
# DOCS_BUILD_CPUS=

# Checks against a preview behind Vercel Authentication (check-urls, check-headers).
# VERCEL_AUTOMATION_BYPASS_SECRET=

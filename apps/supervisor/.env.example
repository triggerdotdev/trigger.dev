# Copy to .env.local. Shared defaults come from the root .env.schema/.env.local.
# This must match the token of the worker group you want to connect to.
TRIGGER_WORKER_TOKEN=

# Override only when connecting to a different local stack:
# MANAGED_WORKER_SECRET=
# TRIGGER_API_URL=http://localhost:3030
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:3030/otel

# @import(../../)
# @defaultSensitive=true
# @defaultRequired=false
# ---

# Token for the worker group this process connects to.
# @required
TRIGGER_WORKER_TOKEN=

# @required
MANAGED_WORKER_SECRET=

# @type=url @sensitive=false
TRIGGER_API_URL=${APP_ORIGIN}

# @type=url @sensitive=false
OTEL_EXPORTER_OTLP_ENDPOINT=${APP_ORIGIN}/otel

# @sensitive=false
DEBUG=1
# @type=number @sensitive=false
TRIGGER_DEQUEUE_INTERVAL_MS=1000

# Optional local TCP log stream.
# @type=port @sensitive=false
SUPERVISOR_TELNET_LOGS_PORT=
